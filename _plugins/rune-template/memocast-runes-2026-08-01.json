      "category": "general",
      "color": "#7E57C2",
      "icon": "whatshot",
      "template": "<template>\r\n    <div>\r\n    <el-input \r\n        v-model=\"count\" \r\n        size=\"small\" \r\n        @blur=\"input\"\r\n    />\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    props: {\r\n        value: {\r\n            type: [String, Number],\r\n            default: null\r\n        }\r\n    },\r\n    methods: {\r\n        input(val) {\r\n            this.$emit('input', val)\r\n        }\r\n    },\r\n    data() {\r\n        return {\r\n            count: this.value\r\n        }\r\n    }\r\n}\r\n</script>"
